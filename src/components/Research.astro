---
import { siteConfig } from "../config";
---

<section id="research" class="p-8 sm:p-12 md:p-16 lg:p-24">
  <div>
    <div class="grid grid-cols-1 lg:grid-cols-12 gap-8 lg:gap-16 items-start">
      <div class="lg:col-span-4">
        <h2
          class="text-3xl sm:text-4xl md:text-5xl xl:text-7xl font-bold text-gray-900"
        >
          Research
        </h2>
        <div
          class="w-[75px] h-[5px] mt-2 rounded-full"
          style={`background-color: ${siteConfig.accentColor}`}
        >
        </div>

        <img
          src="/images/scales.svg"
          alt="Research"
          class="mt-16 w-full max-w-sm rounded-lg "
        />

        <p class="mt-3 max-w-sm text-xs sm:text-sm leading-relaxed text-gray-500 text-justify">
          Fig.1. Our research spans multiple scales of sustainable process systems, from real-time process operation to system-wide scheduling and long-term investment planning.
        </p>
      </div>

      <div class="lg:col-span-8 space-y-8">
        <div class="space-y-6">
          {siteConfig.Research.map((item) => (
            <div>
              <h3 class="text-base sm:text-lg md:text-xl font-bold text-gray-900">
                {item.subtitle}
              </h3>

              <p class="mt-2 text-sm sm:text-base md:text-lg leading-relaxed text-gray-600 whitespace-pre-line text-justify">
                {item.textBeforeBold ? (
                  <>
                    {item.textBeforeBold}
                    <strong class="font-bold text-gray-900">
                      {item.boldText}
                    </strong>
                    {item.textAfterBold}
                  </>
                ) : (
                  item.text
                )}
              </p>

              {item.papers && item.papers.length > 0 && (
                <ul class="mt-3 list-disc list-inside space-y-1 text-xs sm:text-sm text-gray-900">
                  {item.papers.map((paper) => (
                    <li>
                      <a
                        href={paper.link}
                        target="_blank"
                        rel="noopener noreferrer"
                        class="font-medium underline decoration-2 underline-offset-4 hover:opacity-70"
                        style={`text-decoration-color: ${siteConfig.accentColor}`}
                      >
                        {paper.title}
                      </a>
                    </li>
                  ))}
                </ul>
              )}
            </div>
          ))}
        </div>
      </div>
    </div>
  </div>
</section>