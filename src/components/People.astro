---
import { siteConfig } from "../config";
const people = siteConfig.people ?? [];
---

{people.length > 0 && (
  <>
    <div class="grid grid-cols-1 lg:grid-cols-12 gap-8 lg:gap-16 items-start">
      <div class="lg:col-span-4">
        <h2
          class="text-3xl sm:text-4xl md:text-5xl xl:text-7xl font-bold text-gray-900"
        >
          About Us
        </h2>

    <div class="grid gap-6 lg:grid-cols-2">
      {people.map((person) => (
        <div class="rounded-2xl border border-black/10 p-6 shadow-sm">
          <div class="flex items-start gap-4">
            {person.image && (
              <img
                src={person.image}
                alt={person.name}
                class="h-20 w-20 rounded-full object-cover"
              />
            )}

            <div class="min-w-0 flex-1">
              <h3 class="text-xl font-semibold">{person.name}</h3>
              {person.role && <p class="text-sm opacity-70">{person.role}</p>}
            </div>
          </div>

          {person.bio && (
            <p class="mt-4 whitespace-pre-line">{person.bio}</p>
          )}

          {person.links && (
            <p class="mt-4 flex gap-4 text-sm">
              {person.links.linkedin && (
                <a href={person.links.linkedin} target="_blank" rel="noreferrer">
                  LinkedIn
                </a>
              )}
              {person.links.github && (
                <a href={person.links.github} target="_blank" rel="noreferrer">
                  GitHub
                </a>
              )}
            </p>
          )}
        </div>
      ))}
    </div>
    </div>
    </div>
  </>
)}
