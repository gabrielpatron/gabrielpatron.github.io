---
import { siteConfig } from "../config";
const people = siteConfig.people ?? [];
---

{people.length > 0 && (
  <section id="people" class="mx-auto max-w-5xl px-6 py-16">
    <h2 class="mb-8 text-3xl font-semibold">People</h2>

    <div class="grid gap-6 sm:grid-cols-2">
      {people.map((person) => (
        <article class="rounded-2xl border border-black/10 p-6 shadow-sm">
          {person.image && (
            <img
              src={person.image}
              alt={person.name}
              class="mb-4 h-20 w-20 rounded-full object-cover"
            />
          )}

          <h3 class="text-xl font-semibold">{person.name}</h3>
          {person.role && <p class="mt-1 text-sm opacity-70">{person.role}</p>}
          {person.bio && <p class="mt-4 text-sm leading-6 whitespace-pre-line">{person.bio}</p>}

          {person.links && (
            <div class="mt-4 flex gap-4 text-sm">
              {person.links.linkedin && (
                <a href={person.links.linkedin} target="_blank" rel="noreferrer">
                  LinkedIn
                </a>
              )}
              {person.links.github && (
                <a href={person.links.github} target="_blank" rel="noreferrer">
                  GitHub
                </a>
              )}
            </div>
          )}
        </article>
      ))}
    </div>
  </section>
)}
